{
  "datasets": [
    {
      "name": "4214659f",
      "displayName": "sf_airbnb",
      "queryLines": [
        "SELECT   ",
        "  * ",
        "FROM  dm_qa.huanming_qa.sf_airbnb",
        "LIMIT  100"
      ]
    },
    {
      "name": "61b6d88c",
      "displayName": "Per Neighborhoods",
      "queryLines": [
        "-- airbnb neighbourhood_cleansed stats",
        "WITH neighborhood_stats AS (",
        "  SELECT",
        "    neighbourhood_cleansed,",
        "    COUNT(*) AS total_listings,",
        "    AVG(review_scores_rating) AS avg_review_score",
        "  FROM",
        "    dm_qa.huanming_qa.sf_airbnb",
        "  GROUP BY",
        "    neighbourhood_cleansed",
        "),",
        "neighborhood_median AS (",
        "  SELECT",
        "    neighbourhood_cleansed,",
        "    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY review_scores_rating) AS median_review_score",
        "  FROM",
        "    dm_qa.huanming_qa.sf_airbnb",
        "  GROUP BY",
        "    neighbourhood_cleansed",
        ")",
        "SELECT",
        "  ns.neighbourhood_cleansed,",
        "  ns.total_listings,",
        "  ns.avg_review_score,",
        "  nm.median_review_score",
        "FROM",
        "  neighborhood_stats ns",
        "JOIN",
        "  neighborhood_median nm",
        "ON",
        "  ns.neighbourhood_cleansed = nm.neighbourhood_cleansed",
        "ORDER BY",
        "  ns.total_listings DESC",
        "LIMIT 10"
      ]
    },
    {
      "name": "8bf848ca",
      "displayName": "Superhosts Ratio",
      "queryLines": [
        "SELECT",
        "  SUM(CASE WHEN host_is_superhost = 't' THEN 1 ELSE 0 END) / COUNT(*) AS ratio_of_superhost",
        "FROM",
        "    dm_qa.huanming_qa.sf_airbnb   ",
        "    WHERE  ",
        "  ",
        "       "
      ]
    },
    {
      "name": "dc5bb0be",
      "displayName": "Measure",
      "queryLines": [
        "SELECT * FROM samples.nyctaxi.trips"
      ],
      "columns": [
        {
          "displayName": "p per d",
          "description": "",
          "expression": "try_divide(SUM(fare_amount), SUM(trip_distance))"
        }
      ]
    }
